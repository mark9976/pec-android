<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Trust the bundled ABARTA internal server cert for biapps01 -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">biapps01.abarta.com</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
            <certificates src="@raw/biapps01_cert" />
        </trust-anchors>
    </domain-config>

    <!-- Trust the self-signed test cert for local dev -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="false">10.0.0.224</domain>
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
            <certificates src="@raw/pec_test_cert" />
        </trust-anchors>
    </domain-config>

    <!-- Default: trust system + user certs, allow cleartext for http testing -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
